<?xml version="1.0" encoding="UTF-8"?>
<!-- Junction's tests run inside the development site (../teme-dev, or TEME_DEV_PATH), on its own PostgreSQL database, junction_test. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="2G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="ARGON_MEMORY" value="1024"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="ARGON_THREADS" value="1"/>
        <env name="AUTH_TIMEBOX_DURATION" value="50000"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="PAGE_CACHE_ENABLED" value="false"/>
        <env name="TEME_VERSION" value="1.0.0" force="true"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5462" force="true"/>
        <env name="DB_DATABASE" value="junction_test" force="true"/>
        <env name="DB_USERNAME" value="teme"/>
        <env name="DB_PASSWORD" value="teme"/>
        <env name="DB_URL" value=""/>
        <env name="REDIS_URL" value=""/>
        <env name="REDIS_HOST" value="127.0.0.1"/>
        <env name="REDIS_PASSWORD" value=""/>
        <env name="REDIS_PORT" value="6392" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="DB_QUEUE_LONG_DRIVER" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="TEME_AI_ANTHROPIC_KEY" value=""/>
        <env name="TEME_AI_OPENAI_KEY" value=""/>
        <env name="TEME_AI_DEEPSEEK_KEY" value=""/>
        <env name="TEME_AI_OPENROUTER_KEY" value=""/>
        <env name="TEME_BACKUP_MACHINE_KEY" value=""/>
        <env name="TEME_VERIFY_DATABASE" value=""/>
        <env name="APP_PREVIOUS_KEYS" value=""/>
    </php>
</phpunit>
